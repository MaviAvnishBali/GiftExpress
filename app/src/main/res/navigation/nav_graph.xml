<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Splash Fragment -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.giftexpress.app.ui.splash.SplashFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_splash">
        
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Login Fragment -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.giftexpress.app.ui.auth.login.LoginFragment"
        android:label="@string/login"
        tools:layout="@layout/fragment_login">
        
        <action
            android:id="@+id/action_loginFragment_to_signupFragment"
            app:destination="@id/signupFragment" />
        
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />
    </fragment>

    <!-- Forgot Password Fragment -->
    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.giftexpress.app.ui.auth.forgot.ForgotPasswordFragment"
        android:label="Forgot Password"
        tools:layout="@layout/fragment_forgot_password" />

    <!-- Signup Fragment -->
    <fragment
        android:id="@+id/signupFragment"
        android:name="com.giftexpress.app.ui.auth.signup.SignupFragment"
        android:label="@string/signup"
        tools:layout="@layout/fragment_signup">
        
        <action
            android:id="@+id/action_signupFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Home Fragment -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.giftexpress.app.ui.home.HomeFragment"
        android:label="@string/home"
        tools:layout="@layout/fragment_home" />

    <!-- Categories Fragment -->
    <fragment
        android:id="@+id/categoriesFragment"
        android:name="com.giftexpress.app.ui.categories.CategoriesFragment"
        android:label="Categories"
        tools:layout="@layout/fragment_categories" />

    <!-- Offers Fragment -->
    <fragment
        android:id="@+id/offersFragment"
        android:name="com.giftexpress.app.ui.offers.OffersFragment"
        android:label="Offers"
        tools:layout="@layout/fragment_offers" />

    <!-- Orders Fragment -->
    <fragment
        android:id="@+id/ordersFragment"
        android:name="com.giftexpress.app.ui.orders.OrdersFragment"
        android:label="Orders"
        tools:layout="@layout/fragment_orders">
        <action
            android:id="@+id/action_ordersFragment_to_orderDetailsFragment"
            app:destination="@id/orderDetailsFragment" />
    </fragment>

    <!-- Order Details Fragment -->
    <fragment
        android:id="@+id/orderDetailsFragment"
        android:name="com.giftexpress.app.ui.orders.OrderDetailsFragment"
        android:label="Order Details"
        tools:layout="@layout/fragment_order_details">
        <argument
            android:name="orderId"
            app:argType="string" />
    </fragment>

    <!-- Account Fragment -->
    <fragment
        android:id="@+id/accountFragment"
        android:name="com.giftexpress.app.ui.account.AccountFragment"
        android:label="Account"
        tools:layout="@layout/fragment_account">
        
        <action
            android:id="@+id/action_accountFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_accountFragment_to_changePasswordFragment"
            app:destination="@id/changePasswordFragment" />

        <action
            android:id="@+id/action_accountFragment_to_aboutUsFragment"
            app:destination="@id/aboutUsFragment" />

        <action
            android:id="@+id/action_accountFragment_to_shippingInfoFragment"
            app:destination="@id/shippingInfoFragment" />

        <action
            android:id="@+id/action_accountFragment_to_privacyPolicyFragment"
            app:destination="@id/privacyPolicyFragment" />

        <action
            android:id="@+id/action_accountFragment_to_termsConditionsFragment"
            app:destination="@id/termsConditionsFragment" />
    </fragment>

    <!-- About Us Fragment -->
    <fragment
        android:id="@+id/aboutUsFragment"
        android:name="com.giftexpress.app.ui.account.AboutUsFragment"
        android:label="About Us"
        tools:layout="@layout/fragment_account" />

    <!-- Shipping Info Fragment -->
    <fragment
        android:id="@+id/shippingInfoFragment"
        android:name="com.giftexpress.app.ui.account.ShippingInfoFragment"
        android:label="Shipping Information"
        tools:layout="@layout/fragment_account" />

    <!-- Privacy Policy Fragment -->
    <fragment
        android:id="@+id/privacyPolicyFragment"
        android:name="com.giftexpress.app.ui.account.PrivacyPolicyFragment"
        android:label="Privacy Policy"
        tools:layout="@layout/fragment_account" />

    <!-- Terms Conditions Fragment -->
    <fragment
        android:id="@+id/termsConditionsFragment"
        android:name="com.giftexpress.app.ui.account.TermsConditionsFragment"
        android:label="Terms and Conditions"
        tools:layout="@layout/fragment_account" />

    <!-- Change Password Fragment -->
    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.giftexpress.app.ui.account.ChangePasswordFragment"
        android:label="Change Password"
        tools:layout="@layout/fragment_change_password" />


    <!-- Product Details Fragment -->
    <fragment
        android:id="@+id/productDetailsFragment"
        android:name="com.giftexpress.app.ui.product.ProductDetailsFragment"
        android:label="Product Details"
        tools:layout="@layout/fragment_order_details"> <!-- Reusing layout for tools preview, or create empty one -->
        <argument
            android:name="sku"
            app:argType="string" />
    </fragment>

    <!-- Category Fragment -->
    <fragment
        android:id="@+id/categoryFragment"
        android:name="com.giftexpress.app.ui.category.CategoryFragment"
        android:label="Category"
        tools:layout="@layout/fragment_home">
        <argument
            android:name="categoryId"
            app:argType="integer" />
        <argument
            android:name="categoryName"
            app:argType="string" />
    </fragment>

    <!-- Address Book Fragment -->
    <fragment
        android:id="@+id/addressBookFragment"
        android:name="com.giftexpress.app.ui.address.AddressBookFragment"
        android:label="Address Book"
        tools:layout="@layout/fragment_account" />

    <!-- Address Form Fragment -->
    <fragment
        android:id="@+id/addressFormFragment"
        android:name="com.giftexpress.app.ui.address.AddressFormFragment"
        android:label="Address Form"
        tools:layout="@layout/fragment_account">
        <argument
            android:name="address"
            app:argType="com.giftexpress.app.data.model.Address"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <!-- Account Information Fragment -->
    <fragment
        android:id="@+id/accountInfoFragment"
        android:name="com.giftexpress.app.ui.account.AccountInfoFragment"
        android:label="Account Information"
        tools:layout="@layout/fragment_account" />

    <!-- Rewards Fragment -->
    <fragment
        android:id="@+id/rewardsFragment"
        android:name="com.giftexpress.app.ui.account.RewardsFragment"
        android:label="My Rewards"
        tools:layout="@layout/fragment_account" />

    <!-- Rewards History Fragment -->
    <fragment
        android:id="@+id/rewardsHistoryFragment"
        android:name="com.giftexpress.app.ui.account.RewardsHistoryFragment"
        android:label="My Rewards History"
        tools:layout="@layout/fragment_account" />

</navigation>
